{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/admin/**",
              "components/diagrams/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:VTEX Trust))/i]",
        "message": "Font not provided by the design system. Available: VTEX Trust."
      },
      {
        "selector": "JSXOpeningElement[name.name='AdminAlert'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|children|style|key|ref|className|style|children)$/]",
        "message": "<AdminAlert> doesn't accept that prop. Declared props: type, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AdminAlert'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:success|danger|warning)$/]",
        "message": "<AdminAlert> type must be one of 'success' | 'danger' | 'warning'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AdminBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|children|style|key|ref|className|style|children)$/]",
        "message": "<AdminBadge> doesn't accept that prop. Declared props: type, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AdminBadge'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:neutral|success|danger|warning)$/]",
        "message": "<AdminBadge> type must be one of 'neutral' | 'success' | 'danger' | 'warning'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AdminButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<AdminButton> doesn't accept that prop. Declared props: variant, size, disabled, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AdminButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|tertiary|danger)$/]",
        "message": "<AdminButton> variant must be one of 'primary' | 'secondary' | 'tertiary' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AdminButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:regular|small)$/]",
        "message": "<AdminButton> size must be one of 'regular' | 'small'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AdminInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|placeholder|value|onChange|helper|error|style|key|ref|className|style|children)$/]",
        "message": "<AdminInput> doesn't accept that prop. Declared props: label, placeholder, value, onChange, helper, error, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DiagramGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|external|children|style|key|ref|className|style|children)$/]",
        "message": "<DiagramGroup> doesn't accept that prop. Declared props: label, external, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DiagramLegend'] > JSXAttribute > JSXIdentifier[name!=/^(?:kinds|style|key|ref|className|style|children)$/]",
        "message": "<DiagramLegend> doesn't accept that prop. Declared props: kinds, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DiagramNode'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|label|sublabel|style|key|ref|className|style|children)$/]",
        "message": "<DiagramNode> doesn't accept that prop. Declared props: kind, label, sublabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DiagramNode'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:native|custom|external|middleware)$/]",
        "message": "<DiagramNode> kind must be one of 'native' | 'custom' | 'external' | 'middleware'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DiagramTitle'] > JSXAttribute > JSXIdentifier[name!=/^(?:subtitle|style|key|ref|className|style|children)$/]",
        "message": "<DiagramTitle> doesn't accept that prop. Declared props: subtitle, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NoteBox'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<NoteBox> doesn't accept that prop. Declared props: children, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
